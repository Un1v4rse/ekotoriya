# Пример переменных окружения для docker compose (Этап 6.4, AR-8).
# Скопируйте в .env и заполните. НЕ коммитьте реальный .env.

SECRET_KEY=change-me-to-long-random-string
ADMIN_USER=admin
ADMIN_PASS=change-me-strong-password

# Интеграции маркетплейсов (без токенов каталог работает в демо-режиме)
WB_API_TOKEN=
OZON_CLIENT_ID=
OZON_API_KEY=

# БД и режим (значения по умолчанию — совпадают с Dockerfile/compose)
# DATABASE_URL=sqlite:////app/data/ekotoriya.db
# CACHE_TYPE=SimpleCache
# FORCE_HTTPS=0
